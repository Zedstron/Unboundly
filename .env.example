# Environment
APP_ENV=dev
IDENTITY_MODE=both

# Redis Hosting
REDIS_URL=redis://localhost:6379/0

# LLM Provider
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=
LLM_MODEL=

# Embedding Provider
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Logger Config
LOGGING_ENABLED=true
LOG_LEVEL=INFO
LOG_FILE_PATH=


# WPP Bridge
# Configure only if you want to attach real number/identity with persona
# Whatsapp account is needed ofcourse
WPPBRIDGE_ENABLED=0
WPPBRIDGE_SESSION=persona_id
WPPBRIDGE_TOKEN_DIR=
WPPBRIDGE_QUEUE_SIZE=50
WPPBRIDGE_HEADLESS=1

# Instagram Bridge
# Configure only if you want to attach real instagram account
# Instagrarm account is needed ofcourse
INSTABRIDGE_ENABLED=0
INSTABRIDGE_USERNAME=
INSTABRIDGE_PASSWORD=
INSTABRIDGE_SESSION_FILE=
INSTABRIDGE_QUEUE_SIZE=100
INSTABRIDGE_SESSION=personaid # no random must match persona running.
INSTABRIDGE_AUTH_CODE=644664 # Authenticator code (due to a bug in library its a must)

# MCP Remote Servers
# Comma-separated list of remote MCP server.
# Leave empty to disable tool use.
# Example: MCP_SERVER_URLS=https://tools.example.com/sse,https://search.example.com/sse
MCP_SERVER_URLS=